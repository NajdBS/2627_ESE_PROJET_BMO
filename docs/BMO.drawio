<mxfile host="app.diagrams.net" pages="6">
  <diagram name="1. System Definition" id="V-uKOxWwBl-lRot9pOp1">
    <mxGraphModel dx="1103" dy="564" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#F8F9FA" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4d6b99;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=#3b5275;" value="1. System Definition &amp;amp; Requirements&#xa;Robot Mobile Garbage Collector (BMO)" vertex="1">
          <mxGeometry height="70" width="280" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="t1_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontColor=#000000;" value="1.1 Inputs&#xa;(Sensing &amp;amp; Measurement)" vertex="1">
          <mxGeometry height="60" width="220" x="380" y="45" as="geometry" />
        </mxCell>
        <mxCell id="t1_1_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;" value="- 2D LiDAR 360 (LD06) : Detection canettes et robots adverses, cartographie (Option A).&#xa;- Capteurs ToF Sol (2x VL53L0X) : Detection du vide / anti-chute bord de table (Niveau 0).&#xa;- Capteurs ToF Avant (3x VL53L0X) : Detection canettes en arc fixe (Option B Secours).&#xa;- Capteur Couleur (APDS-9960) : Identification canette rouge ou verte dans la pince.&#xa;- Encodeurs Moteurs (Hall A/B) : Odometrie, distance parcourue et vitesse des roues.&#xa;- IMU 6 axes (MPU6050) : Gyroscope anti-derive angulaire en virage (soude PCB)." vertex="1">
          <mxGeometry height="90" width="750" x="660" y="30" as="geometry" />
        </mxCell>
        <mxCell id="e1_1" edge="1" parent="1" source="t1_1" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" target="t1_1_desc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontColor=#000000;" value="1.2 Outputs&#xa;(Actuation &amp;amp; Feedback)" vertex="1">
          <mxGeometry height="60" width="220" x="380" y="155" as="geometry" />
        </mxCell>
        <mxCell id="t1_2_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;" value="- 2x Moteurs Propulsion (FIT0483) : Commande differentielle PWM via driver DRV8833.&#xa;- Servomoteur Pince (SER0039) : Ouverture et serrage mecanique de la canette.&#xa;- Ecran Visage BMO (OLED 1.3 I2C) : Expressions animees (yeux, sourire, alerte) et telemetrie.&#xa;- Spot LED Blanche : Eclairage artificiel dans la pince pour lecture de couleur 100% fiable.&#xa;- LEDs d Etat : Temoins d alimentation, statut batterie et erreurs systeme." vertex="1">
          <mxGeometry height="90" width="750" x="660" y="140" as="geometry" />
        </mxCell>
        <mxCell id="e1_2" edge="1" parent="1" source="t1_2" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" target="t1_2_desc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontColor=#000000;" value="1.3 Processing Unit&#xa;(Cerveau STM32)" vertex="1">
          <mxGeometry height="60" width="220" x="380" y="265" as="geometry" />
        </mxCell>
        <mxCell id="t1_3_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;" value="- Microcontroleur : STM32G431RBT6 ou STM32G474RBT3 (ARM Cortex-M4F @ 170 MHz, LQFP-64).&#xa;- Architecture Multi-Bus : 3x controleurs I2C materiels independants (I2C1, I2C2, I2C3) + 2x UART DMA.&#xa;- Fonctions Cles : Asservissement PID moteurs, odometrie en quadrature, rafraichissement ecran DMA.&#xa;- Firmware : Architecture FreeRTOS multitache, machine a etats finis de strategie (FSM)." vertex="1">
          <mxGeometry height="90" width="750" x="660" y="250" as="geometry" />
        </mxCell>
        <mxCell id="e1_3" edge="1" parent="1" source="t1_3" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" target="t1_3_desc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontColor=#000000;" value="1.4 Power Management&#xa;(Batterie &amp;amp; Regulation)" vertex="1">
          <mxGeometry height="60" width="220" x="380" y="375" as="geometry" />
        </mxCell>
        <mxCell id="t1_4_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;" value="- Source : Accu Li-ion 18650 Haute Decharge (Samsung 30Q 3000mAh 15A continu).&#xa;- BMS &amp;amp; Chargeur : BQ25896 avec port USB-C (charge rapide jusqu a 3A) + Power-Path management.&#xa;- Rail Puissance 5V : Convertisseur synchrone Boost integre au BQ25896 (jusqu a 3.1A).&#xa;- Rail Logique 3.3V : Regulateur lineaire LDO BU33SD5 connecte sur 5V (zero dropout garanti)." vertex="1">
          <mxGeometry height="90" width="750" x="660" y="360" as="geometry" />
        </mxCell>
        <mxCell id="e1_4" edge="1" parent="1" source="t1_4" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" target="t1_4_desc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1_5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontColor=#000000;" value="1.5 Communication&#xa;Interfaces" vertex="1">
          <mxGeometry height="60" width="220" x="380" y="485" as="geometry" />
        </mxCell>
        <mxCell id="t1_5_desc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;" value="- Architecture 3x Bus I2C (400 kHz) [OPTION B BLINDEE] :&#xa;  * I2C1 (PB8/PB9) : Capteurs soudes carte mere (Gyroscope MPU6050 + BMS BQ25896).&#xa;  * I2C2 (PB10/PA8) : Ecran OLED 1.3 BMO avec DMA autonome (zero impact sur les capteurs).&#xa;  * I2C3 (PC8/PC9) : Capteurs cables deportes (5x ToF VL53L0X + APDS-9960 couleur).&#xa;- Liaison LiDAR Serie : Port USART1 haute vitesse avec reception continue par DMA.&#xa;- Telemetrie Sans Fil : Module Bluetooth BLE (HM-10) ou ESP sur USART2.&#xa;- Programmation Filaire : Port SWD 5 broches standard pour sonde ST-Link." vertex="1">
          <mxGeometry height="90" width="750" x="660" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e1_5" edge="1" parent="1" source="t1_5" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" target="t1_5_desc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_main1" edge="1" parent="1" source="t1_title" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" target="t1_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_main2" edge="1" parent="1" source="t1_title" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" target="t1_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_main3" edge="1" parent="1" source="t1_title" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" target="t1_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_main4" edge="1" parent="1" source="t1_title" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" target="t1_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_main5" edge="1" parent="1" source="t1_title" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" target="t1_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#567e3a;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=#3e5b2a;" value="2. System Design &amp;amp; Development" vertex="1">
          <mxGeometry height="70" width="280" x="40" y="630" as="geometry" />
        </mxCell>
        <mxCell id="t2_hw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=15;fontSize=11;fontColor=#274e13;" value="Hardware Design : Schematique KiCad avec 3 bus I2C independants (I2C1/2/3) + routage PCB circulaire ~170mm (base LiDAR @ 90mm, ponts en H, connectique universelle JST, fabrication JLCPCB SMT)." vertex="1">
          <mxGeometry height="55" width="1030" x="380" y="600" as="geometry" />
        </mxCell>
        <mxCell id="t2_fw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=15;fontSize=11;fontColor=#274e13;" value="Firmware Development : Code microcontroleur C/C++ sous STM32CubeIDE &amp;amp; FreeRTOS : drivers peripheriques (I2C1/2/3, DMA USART1 LiDAR, Timers PWM &amp;amp; Encodeurs), animations visage BMO et telemetrie." vertex="1">
          <mxGeometry height="55" width="1030" x="380" y="680" as="geometry" />
        </mxCell>
        <mxCell id="e_hw" edge="1" parent="1" source="t2_title" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#82b366;strokeWidth=2;" target="t2_hw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fw" edge="1" parent="1" source="t2_title" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#82b366;strokeWidth=2;" target="t2_fw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
