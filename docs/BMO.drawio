  <diagram name="4. Roadmap &amp; PCB Steps" id="GBQM0NWaqu62QXgwl92_">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#F8F9FA" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontColor=#1d3557;" value="PHASE 1 : SCHEMA &amp;amp; BOM&#xa;Seances 1 a 4" vertex="1">
          <mxGeometry height="65" width="240" x="60" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p1_d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;" value="- Seance 1 : Schema architectural global (3 bus I2C) + BOM preliminaire (LCSC / JLCPCB).&#xa;- Seances 2 &amp;amp; 3 : Schema electronique annote sous KiCad (MCU LQFP-64, BMS BQ25896, Driver DRV8833).&#xa;- Seance 4 : Corrections finales du schema + validation BOM finale pour commande composants." vertex="1">
          <mxGeometry height="75" width="850" x="340" y="55" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;fontColor=#b45f06;" value="PHASE 2 : PLACEMENT PCB&#xa;Seances 5 &amp;amp; 6" vertex="1">
          <mxGeometry height="65" width="240" x="60" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p2_d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;" value="- Seance 5 : Definition du contour PCB (diametre ~170 mm) + placement des connecteurs moteurs/servos/I2C.&#xa;- Contraintes : Respect imperatif de la base LiDAR a 90 mm du sol + position de la pince frontale.&#xa;- Seance 6 : Revue et correction du placement des composants avec l enseignant." vertex="1">
          <mxGeometry height="75" width="850" x="340" y="155" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;fontColor=#274e13;" value="PHASE 3 : ROUTAGE &amp;amp; EXPORT&#xa;Seances 7 a 10" vertex="1">
          <mxGeometry height="65" width="240" x="60" y="260" as="geometry" />
        </mxCell>
        <mxCell id="p3_d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;" value="- Seances 7 &amp;amp; 8 : Routage des pistes de puissance (5V Boost &amp;amp; moteurs), plans de masse GND et bus I2C1/2/3.&#xa;- Seances 9 &amp;amp; 10 : Verification DRC (Design Rule Check), generation des fichiers Gerbers, BOM, CPL JLCPCB.&#xa;- Echeance Toussaint : Lancement fabrication PCB + Rapport Technique d electronique." vertex="1">
          <mxGeometry height="75" width="850" x="340" y="255" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;fontColor=#4a154b;" value="PHASE 4 : FIRMWARE RTOS&#xa;Novembre a Noel" vertex="1">
          <mxGeometry height="65" width="240" x="60" y="360" as="geometry" />
        </mxCell>
        <mxCell id="p4_d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;" value="- Taches FreeRTOS : Tache Asservissement PID Moteurs (100 Hz), Tache LiDAR DMA, Taches I2C1/3.&#xa;- Tache BMO HMI : Moteur d expressions OLED 1.3 sur I2C2 en DMA (zero latence capteurs).&#xa;- Telemetrie BLE : Envoi des donnees live batterie / position vers PC ou smartphone.&#xa;- Echeance Noel : Revue de code Git + Soutenance d informatique embarquee." vertex="1">
          <mxGeometry height="75" width="850" x="340" y="355" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;fontColor=#900c3f;" value="PHASE 5 : STRATEGIE &amp;amp; CHALLENGE&#xa;Debut Janvier" vertex="1">
          <mxGeometry height="65" width="240" x="60" y="460" as="geometry" />
        </mxCell>
        <mxCell id="p5_d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;" value="- Strategie &amp;amp; Comportement : Recalage automatique au depart, recherche et collecte des 3 canettes, evitement.&#xa;- Vendredi 15 Janvier : Grand Challenge Garbage Collector sur table ENSEA !&#xa;- Lundi 18 Janvier : Fin de semestre et depart en PFE !" vertex="1">
          <mxGeometry height="75" width="850" x="340" y="455" as="geometry" />
        </mxCell>
        <mxCell id="box_conn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=20;fontSize=11;fontColor=#333333;" value="LISTE DES CONNECTEURS DU PCB UNIVERSEL BMO (REPARTITION PAR BUS)&#xa;- J_LIDAR : JST 5 pins (5V, GND, USART1_TX, USART1_RX, PWM)&#xa;- J_MOT_G &amp;amp; J_MOT_D : 2x JST-XH 6 pins (Puissance moteurs + Encodeurs Hall A/B)&#xa;- J_SERVO_PINCE &amp;amp; J_SERVO_2 : 2x Header 1x3 male 2.54mm (GND, 5V, PWM)&#xa;- J_OLED_BMO : Header femelle 1x4 (GND, 3V3, SDA2, SCL2 - Bus I2C2 dedie DMA)&#xa;- J_TELEMETRIE : Header male 1x4 (3V3, GND, USART2_TX, USART2_RX)&#xa;- J_COLOR : JST Stemma QT 4/5 pins (3V3, GND, SDA3, SCL3, INT - Bus I2C3)&#xa;- J_TOF_SOL (x2) : 2x JST 5 pins (3V3, GND, SDA3, SCL3, XSHUT - Bus I2C3)&#xa;- J_TOF_AV (x3) : 3x JST 5 pins (3V3, GND, SDA3, SCL3, XSHUT - Bus I2C3)&#xa;- MPU6050 &amp;amp; BMS BQ25896 : Puces CMS soudees sur PCB sur le Bus I2C1 (PB8/PB9)&#xa;- J_SPOT_LED : Header 1x2 (V+, GND commute par MOSFET 2N7002)&#xa;- J_BAT &amp;amp; J_SWD : Embase 2 pins (Accu 18650) + Header 1x5 (ST-Link Debug)" vertex="1">
          <mxGeometry height="225" width="1130" x="60" y="550" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. Lexique &amp; Termes" id="O31RJFh3ApyaMtmlFE5j">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lex_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4d6b99;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=#3b5275;" value="LEXIQUE ET NOMENCLATURE DES TERMES TECHNIQUES DU PROJET BMO" vertex="1">
          <mxGeometry height="50" width="1200" x="50" y="30" as="geometry" />
        </mxCell>
        <mxCell id="c_int" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=15;fontSize=11;fontColor=#1d3557;" value="INT (Interrupt / Interruption Materielle)&#xa;&#xa;Broche d alerte rapide qui fonctionne comme une sonnette.&#xa;Au lieu que le STM32 passe son temps a interroger le capteur en boucle (scrutation / polling), le capteur tire la ligne INT des qu un evenement survient : MPU6050 (nouvelle mesure angulaire prete), APDS-9960 (canette saisie) ou alarme batterie. Le STM32 reagit en 1 microseconde." vertex="1">
          <mxGeometry height="110" width="580" x="50" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c_xshut" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=15;fontSize=11;fontColor=#1d3557;" value="XSHUT (External Shutdown / Mise en Veille)&#xa;&#xa;Broche de marche/arret individuel des capteurs laser ToF VL53L0X.&#xa;Comme tous les capteurs ToF sortent d usine avec la meme adresse I2C (0x29), le microcontroleur les endort tous au demarrage, puis les reveille un par un via leur broche XSHUT pour leur reattribuer une nouvelle adresse I2C unique (0x30, 0x31, 0x32...) sur le bus I2C3 sans aucun conflit." vertex="1">
          <mxGeometry height="110" width="580" x="670" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c_dma" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=15;fontSize=11;fontColor=#274e13;" value="DMA (Direct Memory Access / Acces Direct Memoire)&#xa;&#xa;Controleur materiel specialise dans le transfert autonome de donnees.&#xa;Utilise pour le LiDAR (USART1) et pour l Ecran Visage BMO (I2C2) : le DMA injecte les 1024 octets de la trame graphique en tache de fond directement dans l ecran sans consommer un seul cycle du processeur central !" vertex="1">
          <mxGeometry height="110" width="580" x="50" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c_pwm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=15;fontSize=11;fontColor=#274e13;" value="PWM (Pulse Width Modulation / Modulation de Largeur d Impulsion)&#xa;&#xa;Signal electrique carre haute frequence dont on fait varier le rapport cyclique (temps a l etat haut) :&#xa;- Sur les moteurs DC : Regle la vitesse de rotation de 0 a 100%.&#xa;- Sur les servomoteurs (50 Hz) : Une impulsion entre 1ms et 2ms fixe l angle exact de la pince (ouvert / ferme)." vertex="1">
          <mxGeometry height="110" width="580" x="670" y="230" as="geometry" />
        </mxCell>
        <mxCell id="c_fault" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=15;fontSize=11;fontColor=#b45f06;" value="nFAULT &amp;amp; nSLEEP (Signaux Driver Moteur Actifs a l Etat Bas)&#xa;&#xa;Le petit &quot;n&quot; signifie Active Low (declenche a 0 Volt) :&#xa;- nFAULT : Sortie a drain ouvert qui passe a 0V si le DRV8833 subit une surchauffe thermique, une surintensite ou un court-circuit (alarme securite).&#xa;- nSLEEP : Entree mise a 0V pour endormir le driver et couper toute consommation quand BMO est a l arret." vertex="1">
          <mxGeometry height="110" width="580" x="50" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c_ce" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=15;fontSize=11;fontColor=#b45f06;" value="CE (Charge Enable / Activation de la Charge)&#xa;&#xa;Broche logique du gestionnaire de batterie BQ25896.&#xa;Elle permet au microcontroleur ou a la securite materielle d autoriser ou de couper instantanement le courant de charge injecte dans la batterie Li-ion en cas d anomalie de temperature detectee sur la sonde thermique." vertex="1">
          <mxGeometry height="110" width="580" x="670" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c_swd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=15;fontSize=11;fontColor=#4a154b;" value="SWD (Serial Wire Debug / Port de Flashage &amp;amp; Debug)&#xa;&#xa;Protocole standard de debogage ARM sur 2 fils de signal :&#xa;- SWDIO : Serial Wire Data Input/Output (echange de donnees bidirectionnel).&#xa;- SWCLK : Serial Wire Clock (signal d horloge synchrone).&#xa;Permet de televerser le binaire dans la Flash et de poser des points d arret (breakpoints) en temps reel via ST-Link." vertex="1">
          <mxGeometry height="110" width="580" x="50" y="490" as="geometry" />
        </mxCell>
        <mxCell id="c_mosfet" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=15;fontSize=11;fontColor=#4a154b;" value="MOSFET (Transistor de Commande de Puissance &amp;amp; Interlock VT5)&#xa;&#xa;Transistors a effet de champ (2N7002 en boitier SOT-23) :&#xa;- Spot LED : Commute le courant de 25 mA pour eclairer la pince sans surcharger le GPIO du STM32.&#xa;- Interlock VT5 : Coupe automatiquement le mode Boost 5V des que le port USB est branche au PC." vertex="1">
          <mxGeometry height="110" width="580" x="670" y="490" as="geometry" />
        </mxCell>
        <mxCell id="c_bus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=15;fontSize=11;fontColor=#900c3f;" value="ARCHITECTURE A 3 BUS I2C INDEPENDANTS DE BMO [OPTION B]&#xa;&#xa;Au lieu d un bus unique ou l ecran sature le trafic, BMO utilise 3 controleurs I2C materiels :&#xa;- I2C1 (PB8/PB9) : Capteurs soudes carte mere (MPU6050 gyro + BQ25896 BMS). Zero parasite.&#xa;- I2C2 (PB10/PA8) : Ecran OLED 1.3 BMO. Flux lourd (1 Ko/trame) gere en DMA sans bloquer le CPU.&#xa;- I2C3 (PC8/PC9) : 5x ToF + APDS-9960. Isoles sur cables : si un cable a un choc, le gyro ne freeze pas !&#xa;- UART : Liaisons serie haut debit (USART1 DMA pour le LiDAR, USART2 pour la telemetrie BLE)." vertex="1">
          <mxGeometry height="120" width="580" x="50" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c_odo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=15;fontSize=11;fontColor=#900c3f;" value="ODOMETRIE &amp;amp; ENCODEURS EN QUADRATURE&#xa;&#xa;Technique de localisation spatiale par comptage des impulsions de roues.&#xa;Les encodeurs magnetiques des moteurs FIT0483 emettent deux signaux sinusoidaux decales de 90 degres (Voies A et B). Le STM32 (mode Timer Encoder) deduit simultanement le sens de rotation, le nombre exact de tours de chaque roue, la distance parcourue et l angle du robot sur la table." vertex="1">
          <mxGeometry height="120" width="580" x="670" y="620" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. Cadres Schematique PCB" id="LEHtkRDPtKxa4v1DTzmp">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sch_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#501060;fontColor=#ffffff;fontStyle=1;fontSize=14;strokeColor=#3b0b47;" value="CHECKLIST DES CADRES FONCTIONNELS A INCLURE DANS LA SCHEMATIQUE KICAD" vertex="1">
          <mxGeometry height="45" width="1460" x="50" y="25" as="geometry" />
        </mxCell>
        <mxCell id="cadre1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=15;fontSize=11;fontColor=#1d3557;fontStyle=0;" value="CADRE 1 : ALIMENTATION &amp;amp; CHARGEUR BMS&#xa;&#xa;â€¢ Puce Principale : BQ25896RTWR (WQFN-24) + LDO BU33SD5WG-TR (SSOP5)&#xa;â€¢ Entree USB-C : Port USB-C avec resistances pull-down 5.1k sur CC1 et CC2&#xa;â€¢ Inductance de Puissance : 1.0 uH a 1.5 uH blindee (courant saturant &gt; 3.5A)&#xa;â€¢ Condensateurs indispensables :&#xa;   - C_VBUS : 1 uF + 10 uF (16V ceramique)&#xa;   - C_PMID : 10 uF (16V ceramique, tres critique en mode Boost !)&#xa;   - C_SYS (Boost 5V) : 2x 10 uF (10V ceramique)&#xa;   - C_BAT : 2x 10 uF (10V ceramique) + connecteur accu 18650 (2 broches)&#xa;   - LDO 3.3V : C_IN (1 uF) et C_OUT (1 uF a 2.2 uF faible ESR) connecte sur 5V&#xa;â€¢ Securite thermique : Pont diviseur R38 (5.23k) et R39 (30.1k) sur TS (leurre 25 deg C)&#xa;â€¢ Interlock VT5 (2N7002) : Bascule automatique USB-C / Boost 5V batterie" vertex="1">
          <mxGeometry height="295" width="460" x="50" y="85" as="geometry" />
        </mxCell>
        <mxCell id="cadre2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=15;fontSize=11;fontColor=#274e13;fontStyle=0;" value="CADRE 2 : MICROCONTROLEUR STM32 &amp;amp; DECOUPLAGE&#xa;&#xa;â€¢ Puce Principale : STM32G431RBT6 ou STM32G474RBT3 (Boitier LQFP-64)&#xa;â€¢ Reseau de Decouplage VDD (Ultra-Critique) :&#xa;   - 5x condensateurs 100 nF ceramique (1 place devant chaque broche VDD/VSS)&#xa;   - 1x condensateur reservoir 4.7 uF ceramique pres du MCU&#xa;â€¢ Alimentation Analogique Propre (VDDA / VSSA) :&#xa;   - Reliee au 3.3V via une perle de ferrite (Ferrite Bead 600 Ohm @ 100MHz)&#xa;   - Filtrage : 1x 1 uF + 1x 10 nF directement sur VDDA/VSSA&#xa;â€¢ Configuration de Demarrage (Bootloader) :&#xa;   - Broche BOOT0 : Resistance de pull-down 10k vers GND&#xa;â€¢ Circuit de Reset Materiel (NRST) :&#xa;   - Bouton-poussoir Reset + condensateur 100 nF vers GND" vertex="1">
          <mxGeometry height="295" width="460" x="550" y="85" as="geometry" />
        </mxCell>
        <mxCell id="cadre3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=15;fontSize=11;fontColor=#b45f06;fontStyle=0;" value="CADRE 3 : OSCILLATEUR EXTERNE (QUARTZ HSE)&#xa;&#xa;â€¢ Composant : Quartz standard 8.000 MHz ou 16.000 MHz (Boitier SMD 3225)&#xa;â€¢ Capacites de Charge (C_L1 et C_L2) :&#xa;   - 2x condensateurs ceramiques C0G / NP0 de 15 pF a 18 pF&#xa;   - Relies entre chaque broche du quartz et le plan de masse GND propre&#xa;â€¢ Broches MCU : Reliees a OSC_IN (PF0) et OSC_OUT (PF1)&#xa;â€¢ Amortissement optionnel : Resistance serie 0 Ohm / 22 Ohm sur OSC_OUT&#xa;â€¢ Regle de Routage :&#xa;   - Pistes les plus courtes possibles (garder le quartz a moins de 5mm du MCU)&#xa;   - Garder le plan de masse continu sous le quartz sans pistes qui traversent" vertex="1">
          <mxGeometry height="295" width="460" x="1050" y="85" as="geometry" />
        </mxCell>
        <mxCell id="cadre4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=15;fontSize=11;fontColor=#900c3f;fontStyle=0;" value="CADRE 4 : DRIVER MOTEURS &amp;amp; CONNECTEURS ROUES&#xa;&#xa;â€¢ Puce Principale : DRV8833PWPR (Boitier HTSSOP-16 avec PowerPAD)&#xa;â€¢ Decouplage de Puissance VM :&#xa;   - 1x condensateur electrolytique/tantale 22 uF a 47 uF&#xa;   - 1x condensateur ceramique 100 nF (faible ESR place au ras de la broche VM)&#xa;â€¢ Pompe de Charge &amp;amp; Regulation Interne :&#xa;   - VCP : Condensateur 10 nF (tension &gt;= 16V) connecte entre VCP et VM&#xa;   - VINT : Condensateur 2.2 uF connecte entre VINT et GND&#xa;â€¢ Sense de Courant : Relier ISEN1 et ISEN2 directement a GND&#xa;â€¢ Signaux de Controle :&#xa;   - nFAULT : Resistance pull-up 10k vers 3.3V (alarme thermique/court-circuit)&#xa;   - nSLEEP : Resistance pull-up 10k vers 3.3V&#xa;â€¢ 2x Connecteurs Moteurs (JST-XH 6 pins) : OUT1/2, 3V3, GND, EncA, EncB" vertex="1">
          <mxGeometry height="295" width="460" x="50" y="405" as="geometry" />
        </mxCell>
        <mxCell id="cadre5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=15;fontSize=11;fontColor=#4a154b;fontStyle=0;" value="CADRE 5 : ARCHITECTURE A 3 BUS I2C INDEPENDANTS [OPTION B]&#xa;&#xa;â€¢ 3 Paires de Resistances de Tirage OBLIGATOIRES (Pull-ups 4.7k vers 3.3V) :&#xa;   - I2C1 : 2x 4.7k sur PB8 (SCL) et PB9 (SDA)&#xa;   - I2C2 : 2x 4.7k sur PB10 (SCL) et PA8 (SDA)&#xa;   - I2C3 : 2x 4.7k sur PC8 (SCL) et PC9 (SDA)&#xa;â€¢ Repartition Materielle Anti-Goulot et Anti-Parasite :&#xa;   - I2C1 (CÅ“ur PCB Soude) : MPU6050 [0x68] (+ INT sur PB4) + BMS BQ25896 [0x6B]&#xa;   - I2C2 (Visage BMO) : Ecran OLED 1.3 [0x3C] (Header 1x4, gere par DMA 0% CPU)&#xa;   - I2C3 (Capteurs Deportes Cables) : APDS-9960 [0x39] (+ INT sur PC1) + 5x ToF VL53L0X&#xa;â€¢ Gestion des 5 Capteurs ToF VL53L0X sur I2C3 :&#xa;   - 2 connecteurs ToF Sol + 3 connecteurs ToF Avant (3V3, GND, SCL3, SDA3, XSHUT)&#xa;   - Broches XSHUT individuelles sur GPIOs (PA4, PA5, PA6, PA7, PC2) avec pull-down 10k&#xa;   - Immunite absolue : Un choc ou faux contact cable ToF n affecte JAMAIS le gyroscope !" vertex="1">
          <mxGeometry height="295" width="460" x="550" y="405" as="geometry" />
        </mxCell>
        <mxCell id="cadre6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=15;fontSize=11;fontColor=#1d3557;fontStyle=0;" value="CADRE 6 : INTERFACES DE COMMUNICATION SERIE UART&#xa;&#xa;â€¢ Port 1 : LiDAR 360 degres (Connecteur JST 5 broches) :&#xa;   - Pin 1 : +5.0V Puissance&#xa;   - Pin 2 : GND&#xa;   - Pin 3 : USART1_TX (PA9)&#xa;   - Pin 4 : USART1_RX (PA10 - relie au DMA continu)&#xa;   - Pin 5 : PWM_MOTEUR (TIM1_CH1 pour varier la vitesse de rotation)&#xa;   - Capa de filtrage 10 uF + 100 nF sur la broche 5V du connecteur LiDAR&#xa;â€¢ Port 2 : Module Telemetrie Sans Fil (Header male 1x4 broches) :&#xa;   - Pin 1 : +3.3V Logique&#xa;   - Pin 2 : GND&#xa;   - Pin 3 : USART2_TX (PA2)&#xa;   - Pin 4 : USART2_RX (PA3)&#xa;   - Compatible Bluetooth BLE (HM-10), ESP32-C3 ou cable USB-Serie FTDI" vertex="1">
          <mxGeometry height="295" width="460" x="1050" y="405" as="geometry" />
        </mxCell>
        <mxCell id="cadre7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=15;fontSize=11;fontColor=#274e13;fontStyle=0;" value="CADRE 7 : SERVOMOTEURS &amp;amp; SPOT LED BLANCHE&#xa;&#xa;â€¢ Connecteurs Servomoteurs (2x Headers males 1x3 au pas 2.54mm) :&#xa;   - J_SERVO_PINCE : Pin 1 (GND), Pin 2 (+5V), Pin 3 (PWM_TIM15) [SER0039]&#xa;   - J_SERVO_RESERVE : Pin 1 (GND), Pin 2 (+5V), Pin 3 (PWM_TIM16) [Secours]&#xa;â€¢ Condensateur Reservoir 5V (Indispensable) :&#xa;   - 1x condensateur electrolytique 330 uF a 470 uF (10V ou 16V)&#xa;   - Absorbe les pics de courant de 1A lors du blocage de la pince&#xa;â€¢ Circuit de Commande du Spot LED Blanche Pince :&#xa;   - Transistor MOSFET Canal N : 2N7002 (Boitier SOT-23)&#xa;   - Grille (Gate) : Reliee a GPIO_STM32 via resistance serie 100 Ohm&#xa;   - Resistance de rappel (Pull-down) : 10k entre Grille et GND&#xa;   - Source a GND, Drain relie a la cathode de la LED&#xa;   - Resistance de limitation LED : 68 Ohm (sous 5V pour 25 mA de flux lumineux)" vertex="1">
          <mxGeometry height="295" width="460" x="50" y="725" as="geometry" />
        </mxCell>
        <mxCell id="cadre8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=15;fontSize=11;fontColor=#b45f06;fontStyle=0;" value="CADRE 8 : PROGRAMMATION &amp;amp; DEBUG SWD (ST-LINK)&#xa;&#xa;â€¢ Connecteur de Flashage (Header male droit 1x5 au pas 2.54mm) :&#xa;   - Broche 1 : VCC (+3.3V pour reference sonde ST-Link)&#xa;   - Broche 2 : SWDIO (PA13 du STM32)&#xa;   - Broche 3 : SWCLK (PA14 du STM32 - ligne d horloge)&#xa;   - Broche 4 : GND (Masse commune)&#xa;   - Broche 5 : NRST (Ligne de reset pour le flashage sous reset)&#xa;â€¢ Resistance de pull-up interne ou externe 10k sur NRST&#xa;â€¢ Pistes SWD courtes pour eviter le bruit lors du debug pas-a-pas&#xa;â€¢ Emplacement recommande : En bordure de carte pour brancher facilement&#xa;   la nappe ST-Link sans devoir demonter le robot" vertex="1">
          <mxGeometry height="295" width="460" x="550" y="725" as="geometry" />
        </mxCell>
        <mxCell id="cadre9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;fontStyle=0;" value="CADRE 9 : IHM CARTE (BOUTONS &amp;amp; LEDS DE STATUT)&#xa;&#xa;â€¢ Voyants Lumineux (LEDs CMS 0805 ou 0603) :&#xa;   - LED 1 (Verte) : &quot;3V3 POWER&quot; reliee au 3.3V via resistance 1k (Allumee si carte OK)&#xa;   - LED 2 (Bleue) : &quot;STATUS&quot; pilotee par GPIO_PA5 via resistance 470 Ohm (Clignote RTOS)&#xa;   - LED 3 (Rouge) : &quot;ERROR&quot; pilotee par GPIO_PA6 via resistance 470 Ohm&#xa;â€¢ Bouton Poussoir Utilisateur (Start / Mode de Jeu) :&#xa;   - 1x bouton tactile CMS relie entre GPIO_PC13 et GND&#xa;   - Resistance de pull-up 10k vers 3.3V&#xa;   - Condensateur anti-rebond 100 nF en parallele sur le bouton&#xa;â€¢ Permet de lancer le robot sans PC des qu on appuie sur le bouton !" vertex="1">
          <mxGeometry height="295" width="460" x="1050" y="725" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
